# Secrets and local install config.
# Generated by install.sh from .env.example: SECRET_KEY, DISPATCH_JWT_SECRET,
# DISPATCH_ENCRYPTION_KEY, and the Postgres credentials.
/.env

# https://docs.docker.com/compose/extends/
/docker-compose.override.yml

# Local project memory; not published (see CLAUDE.md's own note on this).
/CLAUDE.md

# Downloaded by install.sh's sample-data prompt.
/dispatch-sample-data.dump

# Produced by the Postgres major-version dump/restore procedure in README.md.
/dispatch-pg-upgrade.sql

# Editor / OS
.vscode/
.DS_Store
*.swp
*.swo
*~

# Claude Code local permission overrides; not shared.
/.claude/settings.local.json

# Backups install.sh writes next to .env; they hold the same secrets.
.env.backup-*
